# Copy to a local file that is NOT committed. .gitignore already ignores .env*.
# Never put a real access token in git. Never prefix the access token with NEXT_PUBLIC_.

# Server only. Never commit a real access token. Never prefix it with NEXT_PUBLIC_.
# SQUARE_ENVIRONMENT is sandbox or production. Both charge through Catalog variation ids only.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Browser-safe. Square's Web Payments SDK needs the application id and location id.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
# Optional. Vercel uses /api/shop/checkout when this is unset.
# NEXT_PUBLIC_SQUARE_CHECKOUT_URL=http://127.0.0.1:8787/checkout

# Custom UV-print uploads. Leave blank until Alex connects storage. Never commit real tokens.
# BLOB_READ_WRITE_TOKEN=
# RESEND_API_KEY=
# RESEND_FROM=
# CUSTOM_PRINT_NOTIFY_EMAIL=

# Printful. Server only. Never commit a real token.
# A store-scoped private token does not need X-PF-Store-Id. Leave the store id for reference.
# PRINTFUL_API_TOKEN=
# PRINTFUL_STORE_ID=19021991
# PRINTFUL_AUTO_CONFIRM=true
